{
  "name": "@fortressflag/sdk-web",
  "version": "0.1.0",
  "description": "FortressFlag web client SDK \u2014 zero-dependency TypeScript, fail-safe flag resolution for a single browser context",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/size-gate.mjs",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "example": "node example/serve.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/browser": "^4.1.11",
    "esbuild": "0.28.2",
    "eslint": "^10.8.1",
    "playwright": "1.62.1",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.11"
  }
}
