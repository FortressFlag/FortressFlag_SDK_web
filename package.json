{
  "name": "@fortressflag/sdk-web",
  "version": "1.0.0",
  "description": "FortressFlag web client SDK \u2014 zero-dependency TypeScript, fail-safe flag resolution for a single browser context",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json && node scripts/size-gate.mjs",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "example": "node example/serve.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/browser": "^3.2.7",
    "esbuild": "0.28.2",
    "eslint": "^9.17.0",
    "playwright": "1.62.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.7"
  }
}
